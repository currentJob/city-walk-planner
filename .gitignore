.env
.env.local
.DS_Store

# ── 공급망 스캔 산출 (CI 가 매번 다시 만든다) ─────────────────────────────
sbom.cyclonedx.json

# uv.lock 은 **절대** 무시하지 않는다. 락파일이 빠지면 재현성이 사라지고
# `uv sync --frozen` 도, AC-041 도 성립하지 않는다 (NFR-002).
.local/

# Cloudflare Worker: build output and local tooling (tools/build_worker.py, pywrangler)
worker/src/city_walk_planner/
worker/.venv/
worker/.venv-workers/
worker/python_modules/
worker/node_modules/
worker/.wrangler/
worker/.wrangler-dev.log
worker/.tail.*

